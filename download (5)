:root{
  --bg:#0a0b1e;--fg:#eaeaff;--muted:#a8a9c9;
  --grad: linear-gradient(135deg,#5b8cff 0%,#a259ff 100%);
  --glass: rgba(255,255,255,.06);
  --glass-border: rgba(255,255,255,.12);
}
[data-theme="light"]{ --bg:#f6f7ff; --fg:#101226; --muted:#4a4d70;
  --glass: rgba(255,255,255,.65); --glass-border: rgba(20,20,60,.10);}
*{scrollbar-width:thin;scrollbar-color:#5b8cff transparent}
*::-webkit-scrollbar{width:8px;height:8px}
*::-webkit-scrollbar-thumb{background:var(--grad);border-radius:8px}
html,body{background:var(--bg);color:var(--fg);font-family:'Segoe UI',system-ui,sans-serif;min-height:100%}
body{background:
  radial-gradient(1200px 600px at 10% -10%, rgba(91,140,255,.25), transparent 60%),
  radial-gradient(1000px 500px at 100% 10%, rgba(162,89,255,.25), transparent 60%),
  var(--bg);
  min-height:100vh;overflow-x:hidden;
}
.gradient-text{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.glass-nav{background:var(--glass);backdrop-filter:blur(14px);border-bottom:1px solid var(--glass-border)}
.navbar .nav-link{color:var(--fg);opacity:.85}
.navbar .nav-link:hover{opacity:1}
.glass-card{background:var(--glass);backdrop-filter:blur(14px);border:1px solid var(--glass-border);border-radius:18px;color:var(--fg);transition:transform .25s ease, box-shadow .25s ease}
.glass-card:hover{transform:translateY(-3px);box-shadow:0 20px 50px rgba(91,140,255,.15)}
.btn-neon{background:var(--grad);border:0;color:white;font-weight:600;border-radius:12px;padding:.6rem 1.2rem;box-shadow:0 8px 30px rgba(91,140,255,.35);transition:transform .2s ease}
.btn-neon:hover{color:white;transform:translateY(-2px);box-shadow:0 12px 36px rgba(162,89,255,.5)}
.text-muted-2{color:var(--muted) !important}
.footer{color:var(--muted);border-top:1px solid var(--glass-border)}
.hero{padding-top:80px}
.timeline .tl-item{border-left:3px solid #5b8cff}
.dropzone{border:2px dashed var(--glass-border);border-radius:14px;cursor:pointer;transition:.2s}
.dropzone.drag{border-color:#a259ff;background:rgba(162,89,255,.08)}
.cert-thumb{cursor:zoom-in}
.form-control,.form-select,.input-group-text{background:var(--glass);color:var(--fg);border:1px solid var(--glass-border)}
.form-control:focus,.form-select:focus{background:var(--glass);color:var(--fg);border-color:#a259ff;box-shadow:0 0 0 .2rem rgba(162,89,255,.25)}
.table-dark{--bs-table-bg:transparent}
.bg-orbs{position:fixed;inset:0;pointer-events:none;z-index:-1;overflow:hidden}
.bg-orbs span{position:absolute;width:400px;height:400px;border-radius:50%;filter:blur(90px);opacity:.35;animation:float 14s ease-in-out infinite}
.bg-orbs span:nth-child(1){background:#5b8cff;top:-80px;left:-80px}
.bg-orbs span:nth-child(2){background:#a259ff;bottom:-100px;right:-60px;animation-delay:-4s}
.bg-orbs span:nth-child(3){background:#ff6ec4;top:40%;left:60%;animation-delay:-8s}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-30px)}}
