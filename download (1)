{% extends "base.html" %}
{% block content %}
<div class="container py-4" style="max-width:820px">
  <h3 class="mb-4"><i class="fa fa-gear me-2 gradient-text"></i>Settings</h3>
  <form method="post" class="glass-card p-4">
    <div class="row g-3">
      <div class="col-md-6"><label class="form-label">Organization Name</label>
        <input name="org_name" class="form-control" value="{{ settings.get('org_name','') }}"></div>
      <div class="col-md-6"><label class="form-label">Default Font</label>
        <input name="default_font" class="form-control" value="{{ settings.get('default_font','Helvetica') }}"></div>
      <div class="col-md-6"><label class="form-label">Date Format</label>
        <input name="date_format" class="form-control" value="{{ settings.get('date_format','%d %B %Y') }}"></div>
      <div class="col-md-6"><label class="form-label">Signature Name</label>
        <input name="signature_name" class="form-control" value="{{ settings.get('signature_name','Director') }}"></div>
      <div class="col-md-6"><label class="form-label">Theme</label>
        <select name="theme" class="form-select">
          <option value="dark" {% if settings.get('theme')=='dark' %}selected{% endif %}>Dark</option>
          <option value="light" {% if settings.get('theme')=='light' %}selected{% endif %}>Light</option>
        </select></div>
    </div>
    <hr class="my-4"><h5>Email (SMTP)</h5>
    <p class="text-muted-2"><small>Configure via <code>.env</code>: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_FROM.</small></p>
    <button class="btn btn-neon mt-3"><i class="fa fa-save me-2"></i>Save Settings</button>
  </form>
</div>
{% endblock %}
