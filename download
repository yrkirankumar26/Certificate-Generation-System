{% extends "base.html" %}
{% block content %}
<div class="container py-5" style="max-width:700px">
  <div class="glass-card p-4" data-aos="zoom-in">
    <h3 class="gradient-text mb-3"><i class="fa fa-qrcode me-2"></i>Verify Certificate</h3>
    <form method="get" class="mb-3">
      <div class="input-group">
        <input class="form-control" name="cid" value="{{ cid }}" placeholder="Enter Certificate ID" required>
        <button class="btn btn-neon">Verify</button>
      </div>
    </form>
    {% if cid %}
      {% if result %}
      <div class="alert alert-success"><i class="fa fa-check-circle me-2"></i>Valid certificate</div>
      <table class="table table-dark">
        <tr><th>Certificate ID</th><td>{{ result.certificate_id }}</td></tr>
        <tr><th>Participant</th><td>{{ result.participant_name }}</td></tr>
        <tr><th>Course</th><td>{{ result.course }}</td></tr>
        <tr><th>Organization</th><td>{{ result.organization }}</td></tr>
        <tr><th>Date</th><td>{{ result.date }}</td></tr>
        <tr><th>Grade</th><td>{{ result.grade }}</td></tr>
        <tr><th>Instructor</th><td>{{ result.instructor }}</td></tr>
      </table>
      {% else %}
      <div class="alert alert-danger"><i class="fa fa-times-circle me-2"></i>Invalid Certificate</div>
      {% endif %}
    {% endif %}
  </div>
</div>
{% endblock %}
